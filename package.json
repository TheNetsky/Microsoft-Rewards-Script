{
    "name": "microsoft-rewards-script",
    "version": "5.0.0",
    "description": "Microsoft Rewards automation with browser and API modes.",
    "author": "Netsky",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "pre-build": "npm ci --include=dev && npm run install:browser",
        "install:browser": "patchright install chromium",
        "build": "rimraf dist && tsc && node ./scripts/main/copyAssets.js",
        "start": "node ./dist/index.js",
        "ts-start": "ts-node ./src/index.ts",
        "dev": "ts-node ./src/index.ts -dev",
        "api": "node ./dist/control-api/server.js",
        "dev:api": "npm run build && node ./dist/control-api/server.js",
        "kill-chrome-win": "node ./scripts/main/killBrowser.js",
        "create-docker": "docker build -t microsoft-rewards-script-docker .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clear-diagnostics": "node ./scripts/main/clearDiagnostics.js",
        "clear-sessions": "node ./scripts/main/clearSessions.js",
        "manual-login": "node ./scripts/main/manualLogin.js",
        "open-session": "node ./scripts/main/browserSession.js",
        "check:api": "tsc -p tsconfig.control-api.json",
        "check": "npm run build && npm run check:api && npm run lint && npm run format:check"
    },
    "keywords": [
        "Bing Rewards",
        "Microsoft Rewards",
        "Bot",
        "Script",
        "TypeScript",
        "Playwright"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.19.2",
        "@types/semver": "^7.8.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "chalk": "^6.0.1",
        "fast-xml-parser": "^5.11.2",
        "fingerprint-generator": "^2.1.89",
        "fingerprint-injector": "^2.1.89",
        "ghost-cursor-patchright": "1.0.7",
        "impit": "^0.14.8",
        "ms": "^2.1.3",
        "otpauth": "^9.5.2",
        "p-queue": "^9.3.5",
        "patchright": "^1.64.2",
        "semver": "^7.8.5",
        "ts-node": "^10.9.2",
        "zod": "^4.6.7"
    },
    "overrides": {
        "adm-zip": "^0.6.1",
        "glob": "^14.0.3",
        "minimatch": "^11.0.3"
    },
    "homepage": "https://github.com/TheNetsky/Microsoft-Rewards-Script/#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheNetsky/Microsoft-Rewards-Script.git"
    },
    "bugs": {
        "url": "https://github.com/TheNetsky/Microsoft-Rewards-Script/issues"
    }
}